# Copy to .env (never commit .env). The backend loads <repo root>/.env on startup; blank values keep the defaults. Every variable is optional; the defaults are shown.
# The backend reads these through backend/llm_adapter.py, backend/services/*.py and backend/main.py.

# ---- LLM provider switch (backend/llm_adapter.py)
LLM_PROVIDER=anthropic              # anthropic | openai | deepseek | grok | groq | ollama - which provider complete_json() and chat() use
EMBED_PROVIDER=local                # local (sentence-transformers, offline) | openai - which provider embed() uses
ANTHROPIC_API_KEY=                  # required when LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-5-5   # Claude model id
OPENAI_API_KEY=                     # required when LLM_PROVIDER=openai or EMBED_PROVIDER=openai
OPENAI_BASE_URL=                    # optional; any OpenAI-compatible host. Groq: https://api.groq.com/openai/v1 with a gsk_ key,
                                    # LLM_PROVIDER=openai and OPENAI_MODEL=openai/gpt-oss-120b (JSON mode + tool calling)
                                    # (or simply LLM_PROVIDER=groq with GROQ_API_KEY, below)
OPENAI_MODEL=gpt-4o-mini            # OpenAI chat model id
OPENAI_FALLBACK_MODEL=              # tried once when OPENAI_MODEL is rate-limited (429); default openai/gpt-oss-20b for gpt-oss-120b
OPENAI_REASONING_EFFORT=            # low | medium | high for reasoning models; default low for gpt-oss (keeps JSON inside max_tokens)
OPENAI_EMBED_MODEL=text-embedding-3-small   # OpenAI embedding model when EMBED_PROVIDER=openai
GROQ_API_KEY=                       # required when LLM_PROVIDER=groq; free tier at console.groq.com (also used for Whisper)
GROQ_MODEL=openai/gpt-oss-120b     # GroqCloud model id (OpenAI-compatible API at https://api.groq.com/openai/v1)
DEEPSEEK_API_KEY=                   # required when LLM_PROVIDER=deepseek (platform.deepseek.com)
DEEPSEEK_MODEL=deepseek-flash      # DeepSeek model id (OpenAI-compatible API at https://api.deepseek.com)
XAI_API_KEY=                        # required when LLM_PROVIDER=grok (console.x.ai)
XAI_MODEL=grok-4.3                 # Grok model id (OpenAI-compatible API at https://api.x.ai/v1)
OLLAMA_HOST=http://localhost:11434  # Ollama server when LLM_PROVIDER=ollama (local fallback)
OLLAMA_MODEL=llama3.2               # Ollama model name
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2   # local embedding model (384-dim)

# ---- External data (M5 evidence services)
GITHUB_TOKEN=                       # optional personal token; raises the GitHub REST limit from 60 to 5000 req/h
GITHUB_CACHE_PATH=                  # default demo/cached_responses.json - cached GitHub data, checked before the API (demo username works offline)

# ---- Offline demo replay (see demo/README.md)
LLM_CACHE_PATH=                     # e.g. demo/cached_responses.json - replay recorded complete_json() answers (keyed by sha256 of schema + prompt)
LLM_CACHE_RECORD=0                  # 1 = also record every new answer into LLM_CACHE_PATH (used by scripts/build_demo_cache.py)

# ---- Datasets (backend/services/data.py, backend/services/normalize.py); defaults are the files in data/
ROLES_PATH=                         # default data/roles.json
JOBS_PATH=                          # default data/jobs.json
RESOURCES_PATH=                     # default data/resources.json
SKILL_ALIASES_PATH=                 # default data/skill_aliases.json

# ---- Server (backend/main.py)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # comma-separated browser origins allowed to call the API
PORT=8000                           # port uvicorn listens on (Docker / Render)
